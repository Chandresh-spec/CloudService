```gitignore
# Environment variables and secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/

# Build and test artifacts
coverage/
htmlcov/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
*.log

# Local databases
*.db
*.sqlite3
```